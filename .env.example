# PostgreSQL-verbinding (bv. Neon: postgresql://user:wachtwoord@host/dbname?sslmode=require)
DATABASE_URL=postgresql://user:password@localhost:5432/demo

# Verplicht zodra FLASK_ENV=production: lange willekeurige string.
FLASK_SECRET_KEY=change_me_to_a_long_random_secret
FLASK_ENV=development
FLASK_DEBUG=0

# Portfolio-demo: alleen lezen, geen MFA, demo-login getoond op de inlogpagina.
DEMO_MODE=1
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo1234

SESSION_COOKIE_SECURE=0
ENABLE_CSRF_PROTECTION=1
TRUST_PROXY=0
MFA_ISSUER_NAME=TravelAnalytics
UPLOAD_DB_TIMEOUT_SECONDS=300
